{
  "name": "japanese-reactivation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "speech:check": "node --experimental-strip-types scripts/generate-speech.mjs --check",
    "speech:generate": "node --experimental-strip-types --env-file=.env.local scripts/generate-speech.mjs --generate"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.0",
    "idb": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-fsrs": "5.4.2",
    "workbox-precaching": "7.4.1",
    "workbox-range-requests": "7.4.1",
    "workbox-routing": "7.4.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
